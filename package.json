{
  "name": "bob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "deploy:baota": "bash scripts/deploy-baota.sh",
    "db:tunnel": "bash scripts/pg-tunnel.sh",
    "pg:up": "npm run db:tunnel",
    "pg:down": "echo '当前使用 SSH 数据库隧道；在运行 pg:up 的终端按 Ctrl+C 关闭。'",
    "build": "npm run admin:build",
    "admin:build": "vite build --config src/admin-app/vite.config.js",
    "admin:dev": "vite --config src/admin-app/vite.config.js --host 0.0.0.0",
    "check:openapi": "node scripts/check-openapi-coverage.mjs",
    "check": "npm run lint && npm run check:openapi && npm run test",
    "test": "node --test test/**/*.test.js",
    "test:security": "node --test test/security/*.test.js",
    "lint": "node scripts/check-lint.mjs",
    "typecheck": "node scripts/check-js-syntax.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@alicloud/dingtalk": "2.2.38",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/tea-typescript": "1.8.0",
    "@alicloud/tea-util": "1.4.11",
    "@ant-design/icons": "^6.2.5",
    "@ant-design/pro-components": "^2.8.10",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^5.29.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "jsqr": "^1.4.0",
    "pg": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "overrides": {
    "lodash": "4.18.1",
    "qs": "6.15.3",
    "@ant-design/pro-layout": {
      "path-to-regexp": "8.4.2"
    }
  }
}
