    "@ant-design/icons": "^6.2.5",
    "@ant-design/pro-components": "^2.8.10",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^5.29.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsqr": "^1.4.0",
    "pg": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2",
    "ws": "^8.19.0"
